# Which environment to test: local (default), qa, sit or uat.
# URLs come from src/config/environments.ts; do not set BASE_URL or API_URL here.
TEST_ENV=local

# Optional: other accounts than Toolshop's seeded demo accounts (test-data/login.json).
# In CI these come from each GitHub Environment's secrets and variables.
#CUSTOMER_EMAIL=customer@practicesoftwaretesting.com
#CUSTOMER_PASSWORD=welcome01
#CUSTOMER_NAME=Jane Doe
#ADMIN_EMAIL=admin@practicesoftwaretesting.com
#ADMIN_PASSWORD=welcome01
