# Copy to .env. Real values never go into this template.
#
# Which environment to test: local (default), qa, sit or uat.
# URLs come from src/config/environments.ts; do not set BASE_URL or API_URL.
TEST_ENV=local

# Accounts per environment go in their own file next to this one:
#   .env.uat  for TEST_ENV=uat
#   .env.sit  for TEST_ENV=sit
# A value in .env.<environment> wins over .env; a real environment variable wins over both.
# Without them, Toolshop's public demo accounts (test-data/login.json) are used.
#
# Names to set in .env.uat / .env.sit:
#CUSTOMER_EMAIL=
#CUSTOMER_PASSWORD=
#CUSTOMER_NAME=
#ADMIN_EMAIL=
#ADMIN_PASSWORD=
